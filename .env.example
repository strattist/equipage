# Required
ANTHROPIC_API_KEY=
DISCORD_TOKEN=
ALLOWED_USER_ID=
COACH_CHANNEL_ID=

# Nutritionist (all of these are needed, otherwise it is skipped with a warning)
NUTRITION_CHANNEL_ID=
MEALIE_URL=
# Two tokens from two Mealie users: the read one is used by the model's recipe search,
# the write one only when you press Confirmer.
MEALIE_READ_TOKEN=
MEALIE_WRITE_TOKEN=
# Legacy: one token for both (works, but logs a warning)
# MEALIE_API_TOKEN=

# Optional
# CLAUDE_MODEL=claude-opus-5-5   # claude-sonnet-5-5 is the cheaper option
# TZ=Europe/Paris
# PROGRESS_AUTO_DAYS=0           # 0 = progress chart only on request (!progress); N = also post one when there is new data, at most every N days
# PROGRESS_HOUR=18               # hour of that automatic chart
# NUTRITION_WEEKLY_HOUR=10       # Sunday hour of the nutritionist's weekly question round
# DATA_DIR=./data                # /data in Docker
